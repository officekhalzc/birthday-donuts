# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server only, never expose

# ---- Square (Developer Console -> your application) ----
# These belong to Manna Bakehouse's Square account, so payments settle
# straight to the bakery. Start on sandbox and only change this line when
# the whole flow has been tested end to end.
SQUARE_ENVIRONMENT=sandbox                  # 'sandbox' or 'production'

# Server only. Anyone holding this can move money in the bakery's account —
# it must never be prefixed NEXT_PUBLIC_ and never committed.
SQUARE_ACCESS_TOKEN=EAAA...
SQUARE_LOCATION_ID=L...

# Webhooks -> your subscription -> Signature key.
SQUARE_WEBHOOK_SIGNATURE_KEY=...
# Only needed if the webhook is registered at a different URL than
# NEXT_PUBLIC_SITE_URL + /api/square/webhook. It must match the registered
# URL exactly — a trailing slash or an http/https mismatch fails every time.
# SQUARE_WEBHOOK_URL=https://birthdays.yourdomain.org/api/square/webhook

# ---- Resend (transactional email) ----
RESEND_API_KEY=re_...
# Must be a domain you control and have verified in Resend.
# A gmail.com address CANNOT be used here as the sender.
EMAIL_FROM="Birthday Donuts <birthdays@nourishtoflourish613.org>"
ADMIN_EMAIL=nourishtoflourishevent@gmail.com
BAKERY_EMAIL=meir@themannabakehouse.com

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://birthdays.yourdomain.org
CRON_SECRET=make-up-a-long-random-string
